<?xml version="1.0" encoding="utf-8"?>
<!-- Belt and braces with android:allowBackup="false".
     Nothing this app stores may leave the device through cloud backup or a
     device-to-device transfer: the vault database, its WAL/SHM sidecars and any
     backup file staged in the cache are all excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
