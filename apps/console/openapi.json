  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "service",
          "contract_version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "account_id",
          "expires_at"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "account_id",
          "passkeys",
          "passkeys_available"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "owner_device": {
            "type": [
              "string",
              "null"
            ]
          },
          "passkeys": {
            "type": "integer"
          },
          "passkeys_available": {
            "type": "boolean"
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "member_id",
          "role",
          "name",
          "created_at"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "node",
              "device"
            ]
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeviceList": {
        "type": "object",
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        }
      },
      "Passkey": {
        "type": "object",
        "required": [
          "credential_id",
          "name",
          "created_at"
        ],
        "properties": {
          "credential_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PasskeyList": {
        "type": "object",
        "required": [
          "passkeys"
        ],
        "properties": {
          "passkeys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Passkey"
            }
          }
        }
      },
      "OrgSummary": {
        "type": "object",
        "required": [
          "org_id",
          "name",
          "role"
        ],
        "properties": {
          "org_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "OrgList": {
        "type": "object",
        "required": [
          "orgs"
        ],
        "properties": {
          "orgs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgSummary"
            }
          }
        }
      },
      "OrgMember": {
        "type": "object",
        "required": [
          "account_id",
          "display_name",
          "role",
          "joined_at"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "joined_at": {
            "type": "string"
          }
        }
      },
      "OrgGrant": {
        "type": "object",
        "required": [
          "account_id",
          "role"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "OrgProject": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "my_role",
          "access",
          "environments"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "my_role": {
            "type": "string"
          },
          "access": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgGrant"
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slug",
                "name",
                "protected"
              ],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "protected": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Org": {
        "type": "object",
        "required": [
          "org_id",
          "name",
          "my_role",
          "members",
          "projects"
        ],
        "properties": {
          "org_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "my_role": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgMember"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgProject"
            }
          }
        }
      },
      "OrgInvite": {
        "type": "object",
        "required": [
          "code",
          "role",
          "expires_at"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
