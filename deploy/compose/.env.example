LEASEGATE_DOMAIN=leasegate.example.com
RUST_LOG=info
LEASEGATE_DEPLOYMENT_MODE=self_hosted
LEASEGATE_EXECUTION_MODE=local_gateway
# Set these to the owner of deploy/compose/secrets (`id -u` and `id -g`).
LEASEGATE_RUNTIME_UID=1000
LEASEGATE_RUNTIME_GID=1000
LEASEGATE_INSTANCE_ID=worker-1
# Optional enterprise feature; leave empty for the single-VPS profile.
KEYLEASE_SIEM_SECRETS_FILE=

# Release automation overrides these with content-addressed local image IDs.
LEASEGATE_CONTROL_IMAGE=leasegate-control-plane:local
LEASEGATE_WEB_IMAGE=leasegate-web:local
LEASEGATE_GATEWAY_IMAGE=leasegate-gateway:local

# Fill after bootstrap API returns these opaque IDs.
KEYLEASE_ORGANIZATION_ID=
KEYLEASE_PROJECT_ID=
KEYLEASE_APPROVER_ID=

# Required local Gateway identity for the all-in-one deployment.
LEASEGATE_EDGE_ID=
LEASEGATE_AGENT_ID=
LEASEGATE_CONTROL_VERIFYING_KEY=
LEASEGATE_MCP_ALLOWED_HOSTS=127.0.0.1:8090

# Public recipient and local ciphertext destination used by the host lifecycle
# CLI. The private age identity must remain on a separate trusted system.
LEASEGATE_AGE_RECIPIENT=
LEASEGATE_BACKUP_DIR=
