LEASEGATE_DOMAIN=leasegate.example.com
RUST_LOG=info
LEASEGATE_DEPLOYMENT_MODE=self_hosted
LEASEGATE_EXECUTION_MODE=local_gateway
# Set these to the owner of deploy/compose/secrets (`id -u` and `id -g`).
LEASEGATE_RUNTIME_UID=1000
LEASEGATE_RUNTIME_GID=1000
LEASEGATE_INSTANCE_ID=worker-1

# Fill after bootstrap API returns these opaque IDs.
KEYLEASE_ORGANIZATION_ID=
KEYLEASE_PROJECT_ID=
KEYLEASE_APPROVER_ID=

# Required local Gateway identity for the all-in-one deployment.
LEASEGATE_EDGE_ID=
LEASEGATE_AGENT_ID=
LEASEGATE_CONTROL_VERIFYING_KEY=
LEASEGATE_MCP_ALLOWED_HOSTS=127.0.0.1:8090
