FROM rust:1.94-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p keylease-cloud

FROM debian:bookworm-slim
ARG LEASEGATE_RUNTIME_UID=1000
ARG LEASEGATE_RUNTIME_GID=1000
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid ${LEASEGATE_RUNTIME_GID} keylease && useradd --uid ${LEASEGATE_RUNTIME_UID} --gid keylease --create-home keylease
COPY --from=build /src/target/release/keylease-cloud /usr/local/bin/keylease-cloud
COPY --from=build /src/target/release/keylease-cloud-worker /usr/local/bin/keylease-cloud-worker
USER keylease
ENTRYPOINT ["keylease-cloud"]
