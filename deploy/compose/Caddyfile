{$KEYLEASE_DOMAIN:localhost} {
    encode zstd gzip

    # keylease-server, including the KeyLease Console at /api/console/ (it
    # sends its own Content-Security-Policy).
    handle_path /api/* {
        reverse_proxy control-plane:8080
    }

    handle {
        redir / /api/console/ 302
        respond 404
    }

    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
