{$LEASEGATE_DOMAIN:localhost} {
    encode zstd gzip

    handle_path /api/* {
        reverse_proxy control-plane:8080
    }

    handle {
        root * /srv
        try_files {path} /index.html
        header {
            Content-Security-Policy "default-src 'self'; connect-src 'self' https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; object-src 'none'; frame-ancestors 'none'"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }
        file_server
    }
}
