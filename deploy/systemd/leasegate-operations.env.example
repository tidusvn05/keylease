LEASEGATE_AGE_RECIPIENT=age1replace_me
LEASEGATE_AGE_IDENTITY=/etc/leasegate/age-identity.txt
LEASEGATE_BACKUP_DIR=/var/backups/leasegate
LEASEGATE_BACKUP_RETENTION_DAYS=30
LEASEGATE_ENV_FILE=/opt/leasegate/deploy/compose/.env
LEASEGATE_OPS_STATE_DIR=/opt/leasegate/deploy/compose/.state
LEASEGATE_METRICS_FILE=/opt/leasegate/deploy/compose/.state/leasegate.prom
LEASEGATE_MAX_BACKUP_AGE_SECONDS=90000
LEASEGATE_DISK_WARNING_PERCENT=75
LEASEGATE_DISK_CRITICAL_PERCENT=90
LEASEGATE_CERT_WARNING_DAYS=21
# Optional mode-0600 file containing one HTTPS webhook URL.
LEASEGATE_ALERT_WEBHOOK_FILE=
