[Unit]
Description=KeyLease single-VPS runtime and backup-age monitor
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=@KEYLEASE_USER@
Group=@KEYLEASE_GROUP@
EnvironmentFile=/etc/keylease/operations.env
WorkingDirectory=@KEYLEASE_ROOT@
ExecStart=@KEYLEASE_ROOT@/deploy/operations/monitor.sh
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
