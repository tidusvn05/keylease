KEYLEASE_AGE_RECIPIENT=age1replace_me
KEYLEASE_AGE_IDENTITY=/etc/keylease/age-identity.txt
KEYLEASE_BACKUP_DIR=/var/backups/keylease
KEYLEASE_BACKUP_RETENTION_DAYS=30
KEYLEASE_ENV_FILE=/opt/keylease/deploy/compose/.env
KEYLEASE_OPS_STATE_DIR=/opt/keylease/deploy/compose/.state
KEYLEASE_METRICS_FILE=/opt/keylease/deploy/compose/.state/keylease.prom
KEYLEASE_MAX_BACKUP_AGE_SECONDS=90000
KEYLEASE_DISK_WARNING_PERCENT=75
KEYLEASE_DISK_CRITICAL_PERCENT=90
KEYLEASE_CERT_WARNING_DAYS=21
# Optional mode-0600 file containing one HTTPS webhook URL.
KEYLEASE_ALERT_WEBHOOK_FILE=
